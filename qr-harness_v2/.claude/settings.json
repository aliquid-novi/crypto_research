{
  "permissions": {
    "allow": [
      "Bash(python -m qrlib.cli:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m jupytext:*)",
      "Bash(python -m jupyter nbconvert:*)",
      "Bash(python .claude/hooks/scan_lookahead.py:*)",
      "Bash(python tools/nb_dump.py:*)",
      "Bash(python .claude/hooks/protect_cards.py:*)"
    ],
    "deny": [
      "Edit(research/audit/**)",
      "Write(research/audit/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_cards.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan_lookahead.py\""
          }
        ]
      }
    ]
  }
}
